# Google Gemini API Key for active recall generation in Study Toll-Booth
# If left blank, Comeback automatically runs in resilient Offline Fallback mode with built-in active recall banks.
VITE_GEMINI_API_KEY=

# Google OAuth 2.0 Client ID (Optional)
# If provided, enables official Google Identity Services popup.
# If left blank, the app runs in interactive Demo Google Sign-In mode.
VITE_GOOGLE_CLIENT_ID=
